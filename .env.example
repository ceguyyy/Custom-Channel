# ===== Required =====
CEKAT_API_KEY=paste_your_cekat_api_key_here
CEKAT_INBOX_ID=deb013c0-07ff-44a8-bdff-95f603e4c2d2
# Secret appended to the webhook URL: /api/webhook?token=<WEBHOOK_SECRET>
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Upstash Redis — auto-filled when you connect "Upstash for Redis" (Vercel Marketplace)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ===== Optional: file upload =====
# Auto-filled when you connect a Vercel Blob store. If empty, the 📎 button is hidden.
BLOB_READ_WRITE_TOKEN=

# ===== Optional: branding (all have defaults) =====
BRAND_NAME=Customer Support
BRAND_TAGLINE=Biasanya membalas dalam hitungan menit
BRAND_COLOR=#7c5cff
BRAND_LOGO_URL=
WELCOME_MESSAGE=Halo! 👋 Selamat datang. Ada yang bisa kami bantu hari ini?
# Quick-reply chips, separated by |
QUICK_REPLIES=Info produk|Cek harga|Jadwal & lokasi|Bicara dengan CS
REQUIRE_PHONE=false
REQUIRE_EMAIL=false
# Max messages per visitor per minute
RATE_LIMIT_PER_MIN=20
